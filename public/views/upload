<div class="upload-columns">
    <style>
        .upload-columns {
            display: flex;
            gap: 2rem;
            width: 100%;
            max-width: 900px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .upload-zone {
            flex: 1 1 300px;
            min-width: 280px;
            border: 2px dashed var(--MediumBlue);
            border-radius: 1.5rem;
            padding: 2.5rem 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
        }

        .upload-zone:hover,
        .upload-zone.dragover {
            border-color: var(--LightGreen);
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgba(79, 70, 229, 0.1), 0 8px 10px -6px rgba(79, 70, 229, 0.1);
        }

        .upload-zone.dragover {
            border-style: solid;
        }

        .upload-icon {
            width: 64px;
            height: 64px;
            margin-bottom: 1.5rem;
            color: var(--LightGreen);
        }

        .upload-text {
            font-size: 1.1rem;
            color: var(--DarkGreen);
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

        .upload-hint {
            font-size: 0.9rem;
            color: var(--DarkGreen);
            margin-bottom: 1.5rem;
        }

        input[type="file"] {
            display: none;
        }

        .file-name {
            margin-top: 1rem;
            font-size: 0.85rem;
            color: var(--LightGreen);
            font-weight: 500;
            word-break: break-all;
        }

        /* Responsivo para telas menores */
        @media (max-width: 640px) {
            .upload-columns {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
    <div class="upload-zone" id="drop-controle">
        <svg class="upload-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
        </svg>

        <p class="upload-text"  id="fileName1">Arraste e solte A PLANILHA DE CONTROLE aqui</p>
        
        <p class="upload-hint">Apenas arquivos .xls</p>
        <text-link id="selectBtn1">Selecione <b>a planilha de controle</b></text-link>
        
        <input type="file" id="fileInput1" accept=".xls, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
    </div>
    <div class="upload-zone" id="drop-segmenta">
        <svg class="upload-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
        </svg>

        <p class="upload-text"  id="fileName2">Arraste e solte A PLANILHA DE SEGMENTAÇÃO aqui</p>
        
        <p class="upload-hint">Apenas arquivos .xls</p>
        <text-link id="selectBtn2">Selecione <b>a planilha de segmentação</b></text-link>
        
        <input type="file" id="fileInput2" accept=".xls, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
    </div>
</div>