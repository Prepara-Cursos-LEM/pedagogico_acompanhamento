<div class="upload-columns">
    <style>
        .upload-columns {
            display: grid;
            grid-template-columns: 1fr;
            grid-template-rows: 1fr auto;
            grid-gap: 10px;
            gap: 10px;
            width: 100%;
            height: 100%;
            max-width: 900px;
            flex-wrap: wrap;
            justify-content: center;
        }

        #updateBtn {
            opacity: 0;
            padding: 10px;
            width: 100%;
            transition: opacity 0.3s ease;
        }

        .upload-zone {
            height: 100%;
            min-width: 280px;
            border: 2px dashed var(--MediumBlue);
            padding: 10px;
            gap: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-around;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
        }

        .upload-zone:hover,
        .upload-zone.dragover {
            border-color: var(--LightGreen);
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgba(79, 70, 229, 0.1), 0 8px 10px -6px rgba(79, 70, 229, 0.1);
        }

        .upload-zone.dragover {
            border-style: solid;
        }

        .upload-icon {
            width: 48px;
            height: 48px;
            color: var(--LightGreen);
        }

        .upload-text {
            font-size: 14pt;
            color: var(--DarkGreen);
            font-weight: 500;
            margin: 0;
        }

        .upload-hint {
            font-size: 12pt;
            color: var(--DarkGreen);
            margin: 0;
        }

        input[type="file"] {
            display: none;
        }

        #fileNameDisplay {
            width: 100%;
        }

        #fileNameDisplay ul {
            list-style: none;
            padding: 0;
            margin: 0;
            width: 100%;
        }

        #fileNameDisplay li {
            font-size: 0.85rem;
            color: var(--LightGreen);
            font-weight: 500;
            word-break: break-all;
            padding: 0.5rem;
            margin: 0.25rem 0;
            background: rgba(79, 70, 229, 0.05);
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        #fileNameDisplay li::before {
            content: "📄";
            flex-shrink: 0;
        }

        /* Responsivo para telas menores */
        @media (max-width: 640px) {
            .upload-columns {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>

    <div class="upload-zone" id="dropzone-main">
        <svg class="upload-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4l4 4M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
        </svg>

        <p class="upload-text">Arraste e solte dois arquivos aqui</p>

        <p class="upload-hint">Apenas arquivos .xls (exatamente 2 arquivos)</p>
        <text-link id="selectBtnMain">Selecionar arquivos</text-link>

        <input type="file" id="fileInputMain" accept=".xls, application/vnd.ms-excel" multiple>

        <div id="fileNameDisplay"></div>
    </div>

    <button-squared id="updateBtn">✨ Atualizar!</button-squared>
</div>