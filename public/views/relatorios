        <!-- Segundo estudante -->
        <article class="student-card">
            <header class="student-header">
                <h2 class="student-name">Jena Doe</h2>
                <span class="teacher-label">Professor: Paul Doe</span>
            </header>

            <div class="details-grid">
                <div class="detail-item">
                    <span class="detail-label">Início</span>
                    <span class="detail-value">01-01-2023</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Término</span>
                    <span class="detail-value">12-12-2025</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Aulas Totais</span>
                    <span class="detail-value">60</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Aulas Concluídas</span>
